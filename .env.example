# Server environment. Copy to .env on the VPS and fill in real values.
# Never copy .env.local from your machine: Next.js loads it in production too
# and it would override the Neon DATABASE_URL below.

# Neon pooled connection string (host ends with "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Neon direct connection string (host without "-pooler"). Used only by
# `npm run db:init`; leave empty to reuse DATABASE_URL.
DIRECT_URL=""

# Public origin used for canonical URLs and Open Graph metadata.
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Optional support channels. Hidden from the site when left empty.
NEXT_PUBLIC_WHATSAPP=""
NEXT_PUBLIC_SUPPORT_EMAIL=""

# Signs the admin and customer session cookies. At least 32 characters; generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# Read only by `npm run db:admin`, which creates or resets the administrator.
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# Read only by `npm run db:seller`, which creates or resets this seller and
# assigns every product that has no seller yet. Change the password and re-run
# the script to reset the seller login.
SELLER_EMAIL="citymarketshop250@gmail.com"
SELLER_PASSWORD=""
SELLER_NAME="HighQuality Ltd"

# Google sign-in for customers. Create a Web OAuth client in Google Cloud Console
# and add <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback as an authorized
# redirect URI. Leave both empty to keep the Google buttons disabled.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Flutterwave online payments: debit/credit card plus MTN Mobile Money, Orange Money
# and Wave (XOF channel). Leave FLW_SECRET_KEY empty to keep online payments disabled;
# cash on delivery stays available.
FLW_SECRET_KEY=""
# The secret hash you set in Flutterwave Dashboard -> Settings -> Webhooks, with
# <NEXT_PUBLIC_SITE_URL>/api/payments/flutterwave/webhook as the webhook URL.
FLW_WEBHOOK_HASH=""
# CFA francs charged per US$1 for mobile money (e.g. 600). Required for MTN / Orange / Wave.
PAY_XOF_PER_USD=""
# Optional API origin override for a sandbox or proxy. Leave empty for the live API.
FLW_API_BASE=""
