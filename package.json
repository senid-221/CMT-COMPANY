{
  "name": "cmb-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "postinstall": "node scripts/prisma-generate.mjs",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:init": "node scripts/db-init.mjs",
    "db:seed": "node prisma/seed.mjs",
    "catalog:extract": "node scripts/extract-catalog.mjs",
    "catalog:media": "node scripts/fetch-media.mjs && node scripts/optimize-media.mjs",
    "db:admin": "node prisma/seed-admin.mjs",
    "db:seller": "node prisma/seed-seller.mjs",
    "db:coupons": "node prisma/seed-coupons.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
